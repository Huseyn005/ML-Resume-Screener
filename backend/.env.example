ALLOWED_ORIGINS=https://pushcv.vercel.app,https://statcv.vercel.app,https://pullcv.vercel.app,https://taphire.vercel.app,https://dragcv.vercel.app,https://shortlists.vercel.app,http://localhost:5173,http://localhost:8080
ALLOWED_ORIGIN_REGEX=
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
FINETUNED_REPO=
FINETUNED_REVISION=
HF_TOKEN=
DEBUG_ENDPOINTS=0
MAX_PDF_BYTES=10485760
MAX_PDF_PAGES=20
MAX_REQUEST_BYTES=62914560
MAX_FILES=30
MAX_CONCURRENT_ANALYSES=2
QUEUE_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=20
TRUSTED_PROXY_COUNT=1
LOG_LEVEL=INFO

# Scoring mode: legacy | v2
SCORING_MODE=v2
# Semantic source for v2: calibrated | window
SEMANTIC_SOURCE=window
# Piecewise-linear raw-to-display mapping (0..1 -> 0..100) aligning v2 with 70 (Good) and 85 (Great)
SCORING_DISPLAY_MAP=0:0,0.274424:70,0.449568:85,1:100
